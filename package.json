{
  "name": "claude-chrome-bridge",
  "version": "1.0.0",
  "description": "Chrome extension and MCP server for Claude Code browser automation with unlimited large-file uploads",
  "type": "module",
  "bin": {
    "claude-chrome-bridge": "./dist/server/mcp-server.js"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:extension",
    "build:server": "tsc -p tsconfig.server.json",
    "build:extension": "node scripts/build-extension.mjs",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.extension.json --noEmit",
    "test": "node --test dist/server/**/*.test.js",
    "test:e2e": "node scripts/e2e-chrome.mjs",
    "test:e2e:cursor": "node scripts/e2e-cursor.mjs",
    "package": "node scripts/package-extension.mjs",
    "start:bridge": "node dist/server/bridge.js",
    "start:mcp": "node dist/server/mcp-server.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "ws": "^8.18.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.315",
    "@types/node": "^22.15.0",
    "@types/ws": "^8.18.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0"
  }
}
